# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Private Space password gate (server-side only, checked by api/private-space/unlock.ts)
PRIVATE_SPACE_PIN=2237

# Reverse-proxy allowlist for api/proxy/[site]/[[...path]].ts
# Format: "<key>=<https-origin>;<key2>=<https-origin2>"
# Only add an origin you have a legal right to access and re-serve through your own
# server. Do not enable this for a site whose ToS forbids proxying/mirroring.
PROXY_SITES=
