# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Private Space password gate (server-side only, checked by api/private-space/unlock.ts)
PRIVATE_SPACE_PIN=2237

# Reverse-proxy allowlist for api/proxy-handler.ts (and relay/server.ts, if you use it)
# Format: "<key>=<https-origin>;<key2>=<https-origin2>" — the key is REQUIRED, it's
# what appears in the proxied path (/api/proxy/<key>/...). A bare URL with no
# "key=" prefix is invalid and gets silently ignored (check server logs for a
# "malformed PROXY_SITES entry" warning if /api/proxy/health doesn't list your key).
# Example: PROXY_SITES=cinema=https://topcinema.io
# Only add an origin you have a legal right to access and re-serve through your own
# server. Do not enable this for a site whose ToS forbids proxying/mirroring.
PROXY_SITES=cinema=https://topcinema.io

# --- Home relay (optional) ---
# Only needed if a video-embed provider blocks requests from Vercel's IPs specifically
# (separate from the Referer check api/embed.ts already handles) and you've decided to
# relay those specific requests through your own home connection instead. See
# relay/server.ts and api/_proxy/embedCore.ts for what this does and the tradeoffs.
#
# On Vercel: set HOME_RELAY_URL to your tunnel's public HTTPS hostname (no trailing
# slash), and RELAY_SHARED_SECRET to a long random value.
# On the machine running `npm run relay`: set RELAY_SHARED_SECRET to the SAME value
# (plus PROXY_SITES, since the relay validates "ref" against it too), in this .env file.
# Leave both blank to keep everything routed through Vercel's own api/embed.ts.
HOME_RELAY_URL=
RELAY_SHARED_SECRET=
